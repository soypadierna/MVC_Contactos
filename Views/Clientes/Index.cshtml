@model IEnumerable<MVC_Contactos.Models.Cliente>
@{
    ViewBag.Title = "Lista de Clientes";
    Layout = "~/Views/Shared/_LayoutFacturacion.cshtml";
}
<h2>Lista de Clientes</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}

<div class="well">
    <a asp-action="Create" class="btn btn-primary">NUEVO</a>
</div>

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Documento</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in Model)
            {
                <tr>
                    <td>@cliente.IdCliente</td>
                    <td>@cliente.StrNombre</td>
                    <td>@cliente.NumDocumento</td>
                    <td>@cliente.StrTelefono</td>
                    <td>@cliente.StrEmail</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@cliente.IdCliente" class="btn btn-primary">Editar</a>
                        <button type="button" class="btn btn-danger btn-eliminar" data-id="@cliente.IdCliente" data-nombre="@cliente.StrNombre">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No hay clientes registrados.</div>
}

<div class="modal fade" id="modalEliminar" tabindex="-1" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="DeleteConfirmed" method="post">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Eliminar cliente</h4>
                </div>
                <div class="modal-body">
                    ¿Seguro que desea eliminar a <strong id="nombreEliminar"></strong>?
                </div>
                <div class="modal-footer">
                    <input type="hidden" name="id" id="idEliminar" />
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $(function () {
        $('.btn-eliminar').on('click', function () {
            $('#idEliminar').val($(this).data('id'));
            $('#nombreEliminar').text($(this).data('nombre'));
            $('#modalEliminar').modal('show');
        });
    });
</script>