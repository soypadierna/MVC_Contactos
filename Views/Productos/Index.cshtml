@model IEnumerable<MVC_Contactos.Models.TBLPRODUCTOS>
@{
    ViewBag.Title = "Productos";
}
<h2>Productos</h2>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="well">
    <form method="get" class="form-inline">
        <a asp-action="Nuevo" class="btn btn-primary">NUEVO</a>
        <input type="text" name="q" value="@ViewBag.Q" class="form-control" placeholder="Buscar por nombre o código" />
        <button type="submit" class="btn btn-default">Buscar</button>
    </form>
</div>

@if (Model.Any())
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th style="width:60px">Foto</th>
                <th>Nombre</th>
                <th>Código</th>
                <th>Categoría</th>
                <th>Precio venta</th>
                <th>Stock</th>
                <th style="width:170px">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div style="width:40px;height:40px;text-align:center;line-height:40px">
                            @if (!string.IsNullOrEmpty(item.StrFoto))
                            {
                                <img src="~/uploads/@item.StrFoto" alt="" style="width:40px;height:40px;object-fit:cover" />
                            }
                            else
                            {
                                <span class="glyphicon glyphicon-picture text-muted" style="font-size:24px"></span>
                            }
                        </div>
                    </td>
                    <td>@item.StrNombre</td>
                    <td>@item.StrCodigo</td>
                    <td>@item.Categoria?.StrDescripcion</td>
                    <td>@item.DecPrecioVenta.ToString("N2")</td>
                    <td>@item.IntStock</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.IdProducto" class="btn btn-primary">Editar</a>
                        <button type="button" class="btn btn-danger btn-borrar"
                                data-id="@item.IdProducto" data-nombre="@item.StrNombre">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No hay productos registrados.</div>
}

<div class="modal fade" id="modalBorrar" tabindex="-1" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Borrar">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Confirmar eliminación</h4>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que desea eliminar el producto <strong id="nombreBorrar"></strong>?</p>
                    <input type="hidden" name="id" id="idBorrar" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $(function () {
        $('.btn-borrar').on('click', function () {
            $('#idBorrar').val($(this).data('id'));
            $('#nombreBorrar').text($(this).data('nombre'));
            $('#modalBorrar').modal('show');
        });
    });
</script>