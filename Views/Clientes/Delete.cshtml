@model MVC_Contactos.Models.Cliente
@{
    ViewBag.Title = "Eliminar Cliente";
    Layout = "~/Views/Shared/_LayoutFacturacion.cshtml";
}
<h2>Eliminar Cliente</h2>
<h4>¿Seguro que desea eliminar este cliente?</h4>
<hr />
<p>Id: @Model.IdCliente</p>
<p>Nombre: @Model.StrNombre</p>
<p>Documento: @Model.NumDocumento</p>
<p>Teléfono: @Model.StrTelefono</p>
<p>Email: @Model.StrEmail</p>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" name="id" value="@Model.IdCliente" />
    <input type="submit" value="Eliminar" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-default">Cancelar</a>
</form>