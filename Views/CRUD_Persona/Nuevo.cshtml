@{
    ViewBag.Title = "NUEVO REGISTRO ";
    Layout = "~/Views/Shared/_LayoutModerno.cshtml";
}
<br />
<h2 class="well">@ViewBag.Title </h2>
<br />
<div>
    <form method="post" action="/CRUD_Persona/Nuevo">
        <input type="hidden" name="PersonaId" value="" />
        <p></p>
        Nombre:
        <input type="text" name="Nombre" value="" />
        <p></p>
        Telefono:
        <input type="text" name="Telefono" value="" />
        <p></p>
        Correo:
        <input type="text" name="Email" value="" />
        <p></p>
        <input type="submit" value="GUARDAR" /> <a class="btn btn-primary " href="/CRUD_Persona">Retornar</a>
    </form>
</div>
