@model MVC_Contactos.Models.TBLPRODUCTOS

<div class="form-group">
    <label asp-for="StrNombre" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <input asp-for="StrNombre" class="form-control" placeholder="Ej: Agua mineral 600 ml" />
        <span asp-validation-for="StrNombre" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label asp-for="StrCodigo" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <input asp-for="StrCodigo" class="form-control" placeholder="Ej: AGU-001" />
        <span asp-validation-for="StrCodigo" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label asp-for="IdCategoria" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <select asp-for="IdCategoria" asp-items="(SelectList)ViewBag.IdCategoria" class="form-control">
            <option value="">-- Seleccione una categoría --</option>
        </select>
        <span asp-validation-for="IdCategoria" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label asp-for="DecPrecioCompra" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <input asp-for="DecPrecioCompra" class="form-control" placeholder="Ej: 900.50" />
        <span asp-validation-for="DecPrecioCompra" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label asp-for="DecPrecioVenta" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <input asp-for="DecPrecioVenta" class="form-control" placeholder="Ej: 1500.00" />
        <span asp-validation-for="DecPrecioVenta" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label asp-for="IntStock" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <input asp-for="IntStock" type="text" inputmode="numeric" class="form-control" placeholder="Solo números" />
        <span asp-validation-for="IntStock" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label asp-for="StrDetalle" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <textarea asp-for="StrDetalle" class="form-control" rows="3" placeholder="Opcional"></textarea>
        <span asp-validation-for="StrDetalle" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label class="control-label col-md-2" for="foto">Foto</label>
    <div class="col-md-10">
        @if (!string.IsNullOrEmpty(Model.StrFoto))
        {
            <p><img src="~/uploads/@Model.StrFoto" alt="" style="max-height:120px" /></p>
            <div class="checkbox">
                <label><input type="checkbox" name="quitarFoto" value="true" /> Quitar foto actual</label>
            </div>
        }
        <input type="file" id="foto" name="foto" accept=".jpg,.jpeg,.png,.webp" />
        <span class="help-block">JPG, PNG o WebP. Máximo 3 MB. Opcional.</span>
        @Html.ValidationMessage("foto", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group">
    <div class="col-md-offset-2 col-md-10">
        <input type="submit" value="Guardar" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-default">Cancelar</a>
    </div>
</div>

<script>
    $(function () {
        $('#IntStock').on('input', function () { this.value = this.value.replace(/\D/g, ''); });
    });
</script>