@model IEnumerable<MVC_Contactos.Models.TBLEMPLEADO>
@{
    ViewBag.Title = "Empleados";
}
<h2>Lista de Empleados</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="well">
    <a asp-action="Nuevo" class="btn btn-primary">NUEVO</a>
</div>

@if (Model.Any())
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Documento</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.strNombre</td>
                    <td>@item.NumDocumento</td>
                    <td>@item.StrTelefono</td>
                    <td>@item.StrEmail</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.IdEmpleado" class="btn btn-primary">Editar</a>
                        <a asp-action="Borrar" asp-route-id="@item.IdEmpleado" class="btn btn-danger"
                           onclick="return confirm('¿Seguro que desea eliminar este empleado?');">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No hay empleados registrados.</div>
}