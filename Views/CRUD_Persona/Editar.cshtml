@model MVC_Contactos.Models.ModeloPersona
@{
    ViewBag.Title = "EDITAR PERSONA";
    Layout = "~/Views/Shared/_LayoutModerno.cshtml";
}
<br />
<h2 class="well"><span class="glyphicon glyphicon-list-alt"></span> @ViewBag.Title
</h2>
<br />
<div class="well">
    <form method="post" action="/CRUD_Persona/Editar">

        <input type="hidden" name="PersonaId" value="@Model.PersonaId" />
        <p></p>
        Nombre:
        <input type="text" name="Nombre" value=" @Model.Nombre " />
        <p></p>
        Telefono:
        <input type="text" name="Telefono" value="@Model.Telefono" />
        <p></p>
        Correo:
        <input type="text" name="Email" value="@Model.Email" />
        <p></p>
        <input type="submit" value="GUARDAR" /> - <a class="btn btn-default" href="/CRUD_Persona">Retornar</a>
    </form>
</div>