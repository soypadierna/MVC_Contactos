@model List<MVC_Contactos.Models.ModeloPersona>
@{
    ViewBag.Title = "Personas";
}
<h2>@ViewBag.Titulo</h2>

<div class="well">
    <a asp-action="Nuevo" class="btn btn-primary">NUEVO</a>
</div>

@if (Model.Any())
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.PersonaId</td>
                    <td>@item.Nombre</td>
                    <td>@item.Telefono</td>
                    <td>@item.Email</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.PersonaId" class="btn btn-primary">Editar</a>
                        <a asp-action="Borrar" asp-route-id="@item.PersonaId" class="btn btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No hay personas registradas.</div>
}