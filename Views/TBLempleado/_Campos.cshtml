@model MVC_Contactos.Models.TBLEMPLEADO

<div class="form-group">
    <label asp-for="strNombre" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <input asp-for="strNombre" class="form-control" placeholder="Ej: Laura Gómez" />
        <span asp-validation-for="strNombre" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label asp-for="NumDocumento" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <input asp-for="NumDocumento" class="form-control" placeholder="Solo números" />
        <span asp-validation-for="NumDocumento" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label asp-for="StrDireccion" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <input asp-for="StrDireccion" class="form-control" placeholder="Ej: Cra 10 # 20-30" />
        <span asp-validation-for="StrDireccion" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label asp-for="StrTelefono" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <input asp-for="StrTelefono" class="form-control" placeholder="Ej: 3001234567" />
        <span asp-validation-for="StrTelefono" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label asp-for="StrEmail" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <input asp-for="StrEmail" class="form-control" placeholder="Ej: nombre@empresa.com" />
        <span asp-validation-for="StrEmail" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label asp-for="IdRolEmpleado" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <select asp-for="IdRolEmpleado" asp-items="(SelectList)ViewBag.IdRolEmpleado" class="form-control">
            <option value="">-- Seleccione un rol --</option>
        </select>
    </div>
</div>
<div class="form-group">
    <label asp-for="DtmIngreso" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <input asp-for="DtmIngreso" class="form-control" />
        <span asp-validation-for="DtmIngreso" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label asp-for="DtmRetiro" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <input asp-for="DtmRetiro" class="form-control" />
        <span class="help-block">Dejar vacío si el empleado sigue activo.</span>
        <span asp-validation-for="DtmRetiro" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label asp-for="strDatosAdicionales" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <textarea asp-for="strDatosAdicionales" class="form-control" rows="3" placeholder="Observaciones opcionales"></textarea>
    </div>
</div>
<div class="form-group">
    <div class="col-md-offset-2 col-md-10">
        <input type="submit" value="Guardar" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-default">Cancelar</a>
    </div>
</div>