@model MVC_Contactos.Models.ModeloPersona
@{
    ViewBag.Title = "Eliminar Persona";
}
<h2>Eliminar Persona</h2>
<h4>¿Seguro que desea eliminar esta persona?</h4>
<hr />
<p>Id: @Model.PersonaId</p>
<p>Nombre: @Model.Nombre</p>
<p>Teléfono: @Model.Telefono</p>
<p>Correo: @Model.Email</p>

<form asp-action="BorrarConfirmado" method="post">
    <input type="hidden" name="PersonaId" value="@Model.PersonaId" />
    <input type="submit" value="Eliminar" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-default">Cancelar</a>
</form>