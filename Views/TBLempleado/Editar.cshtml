@model MVC_Contactos.Models.TBLEMPLEADO
@{
    ViewBag.Title = "Editar Empleado";
}
<h2>Editar Empleado</h2>

<form asp-action="Editar" method="post" class="form-horizontal">
    <input type="hidden" asp-for="IdEmpleado" />
    <h4>Empleado</h4>
    <p class="text-muted"><span class="text-danger">*</span> Campo obligatorio</p>
    <hr />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_Campos" model="Model" />
</form>