@model IEnumerable<MVC_Contactos.Models.TBLFACTURAS>
@{
    ViewBag.Title = "Facturas";
    var nombres = (Dictionary<int, string>)ViewBag.Nombres;
}
<h2>Facturas</h2>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="well">
    <form method="get" class="form-inline">
        <a asp-action="Nuevo" class="btn btn-primary">NUEVA</a>
        <input type="text" name="q" value="@ViewBag.Q" class="form-control" placeholder="Buscar por número o cliente" />
        <button type="submit" class="btn btn-default">Buscar</button>
    </form>
</div>

@if (Model.Any())
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>N°</th>
                <th>Fecha</th>
                <th>Cliente</th>
                <th>Emisor</th>
                <th>Total</th>
                <th>Estado</th>
                <th style="width:90px">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdFactura</td>
                    <td>@item.DtmFecha.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@(nombres.TryGetValue(item.IdCliente, out var n) ? n : "Cliente #" + item.IdCliente)</td>
                    <td>@item.Empleado?.strNombre</td>
                    <td class="text-right">@item.DecTotal.ToString("N2")</td>
                    <td><span class="label label-@item.EstadoClase">@item.EstadoTexto</span></td>
                    <td><a asp-action="Detalle" asp-route-id="@item.IdFactura" class="btn btn-primary">Ver</a></td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No hay facturas registradas.</div>
}