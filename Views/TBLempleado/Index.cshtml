@model IEnumerable<MVC_Contactos.Models.TBLEMPLEADO>
@{
    ViewBag.Title = "Empleados";
    var hoy = DateTime.Today;
    string q = ViewBag.Q as string ?? "";
    bool verRetirados = ViewBag.VerRetirados is bool b && b;
}
<h2>Lista de Empleados</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}

<div class="well clearfix">
    <a asp-action="Nuevo" class="btn btn-primary pull-left" style="margin-right:10px">NUEVO</a>
    <form method="get" action="@Url.Action("Index")" class="form-inline pull-right">
        <input type="text" name="q" value="@q" class="form-control" placeholder="Buscar nombre, documento o correo" />
        <button type="submit" class="btn btn-default">Buscar</button>
        <label style="margin-left:10px; font-weight:normal">
            <input type="checkbox" name="verRetirados" value="true" @(verRetirados ? "checked" : "") onchange="this.form.submit()" /> Mostrar retirados
        </label>
    </form>
</div>

@if (Model.Any())
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Documento</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var retirado = item.DtmRetiro != null && item.DtmRetiro <= hoy;
                var programado = item.DtmRetiro != null && item.DtmRetiro > hoy;
                <tr>
                    <td>@item.strNombre</td>
                    <td>@item.NumDocumento</td>
                    <td>@item.StrTelefono</td>
                    <td>@item.StrEmail</td>
                    <td>
                        @if (retirado)
                        {
                            <span class="label label-default">Retirado @item.DtmRetiro?.ToString("dd/MM/yyyy")</span>
                        }
                        else if (programado)
                        {
                            <span class="label label-warning">Retiro programado @item.DtmRetiro?.ToString("dd/MM/yyyy")</span>
                        }
                        else
                        {
                            <span class="label label-success">Activo</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.IdEmpleado" class="btn btn-primary">Editar</a>
                        @if (retirado)
                        {
                            <form asp-action="Reactivar" asp-route-id="@item.IdEmpleado" method="post" style="display:inline">
                                <button type="submit" class="btn btn-success">Reactivar</button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn btn-danger btn-retirar" data-id="@item.IdEmpleado" data-nombre="@item.strNombre">Retirar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No hay empleados para mostrar.</div>
}

<div class="modal fade" id="modalRetirar" tabindex="-1" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Retirar" method="post">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Retirar empleado</h4>
                </div>
                <div class="modal-body">
                    ¿Seguro que desea retirar a <strong id="nombreRetirar"></strong>? Podrá reactivarlo después.
                </div>
                <div class="modal-footer">
                    <input type="hidden" name="id" id="idRetirar" />
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Retirar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $(function () {
        $('.btn-retirar').on('click', function () {
            $('#idRetirar').val($(this).data('id'));
            $('#nombreRetirar').text($(this).data('nombre'));
            $('#modalRetirar').modal('show');
        });
    });
</script>