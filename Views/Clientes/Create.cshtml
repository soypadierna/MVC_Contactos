@model MVC_Contactos.Models.Cliente
@{
    ViewBag.Title = "Nuevo Cliente";
    Layout = "~/Views/Shared/_LayoutFacturacion.cshtml";
}
<h2>Nuevo Cliente</h2>

<form asp-action="Create" method="post" class="form-horizontal">
    <h4>Cliente</h4>
    <p class="text-muted"><span class="text-danger">*</span> Campo obligatorio</p>
    <hr />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_Campos" model="Model" />
</form>