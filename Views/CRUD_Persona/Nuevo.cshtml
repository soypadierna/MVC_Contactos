@model MVC_Contactos.Models.ModeloPersona
@{
    ViewBag.Title = "Nueva Persona";
}
<h2>Nueva Persona</h2>

<form asp-action="Nuevo" method="post" class="form-horizontal">
    <h4>Persona</h4>
    <p class="text-muted"><span class="text-danger">*</span> Campo obligatorio</p>
    <hr />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_Campos" model="Model" />
</form>