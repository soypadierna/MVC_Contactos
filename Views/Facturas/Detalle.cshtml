@model MVC_Contactos.Models.TBLFACTURAS
@{
    ViewBag.Title = "Factura " + Model.IdFactura;
    var cliente = ViewBag.Cliente as MVC_Contactos.Models.Cliente;
    var acciones = (int[])ViewBag.Acciones;
}
<h2>Factura N° @Model.IdFactura <span class="label label-@Model.EstadoClase">@Model.EstadoTexto</span></h2>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="caja">
    <p><strong>Cliente:</strong> @(cliente != null ? cliente.StrNombre : "Cliente #" + Model.IdCliente)</p>
    <p><strong>Emisor:</strong> @Model.Empleado?.strNombre</p>
    <p><strong>Fecha:</strong> @Model.DtmFecha.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Código</th>
            <th class="text-right">Precio</th>
            <th class="text-right">Cantidad</th>
            <th class="text-right">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.Detalles)
        {
            <tr>
                <td>@d.Producto?.StrNombre</td>
                <td>@d.Producto?.StrCodigo</td>
                <td class="text-right">@d.DecPrecioUnitario.ToString("N2")</td>
                <td class="text-right">@d.IntCantidad</td>
                <td class="text-right">@d.DecSubtotal.ToString("N2")</td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered" style="max-width:360px">
    <tr><td>Subtotal</td><td class="text-right">@Model.DecSubtotal.ToString("N2")</td></tr>
    <tr><td>Descuento</td><td class="text-right">@Model.DecDescuento.ToString("N2")</td></tr>
    <tr><td>IVA</td><td class="text-right">@Model.DecIva.ToString("N2")</td></tr>
    <tr><th>Total</th><th class="text-right">@Model.DecTotal.ToString("N2")</th></tr>
</table>

<div>
    @foreach (var a in acciones)
    {
        if (a == 3)
        {
            <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#modalAnular">Anular</button>
        }
        else
        {
            <form asp-action="CambiarEstado" method="post" style="display:inline">
                <input type="hidden" name="id" value="@Model.IdFactura" />
                <input type="hidden" name="nuevoEstado" value="@a" />
                <button type="submit" class="btn btn-primary">@(a == 2 ? "Marcar pagada" : "Marcar vencida")</button>
            </form>
        }
    }
    <a asp-action="Index" class="btn btn-default">Volver</a>
</div>

<div class="modal fade" id="modalAnular" tabindex="-1" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="CambiarEstado">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Confirmar anulación</h4>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que desea anular la factura <strong>N° @Model.IdFactura</strong>? Se repondrá el stock y no se podrá reactivar.</p>
                    <input type="hidden" name="id" value="@Model.IdFactura" />
                    <input type="hidden" name="nuevoEstado" value="3" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Anular</button>
                </div>
            </form>
        </div>
    </div>
</div>