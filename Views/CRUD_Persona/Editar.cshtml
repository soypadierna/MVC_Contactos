@model MVC_Contactos.Models.ModeloPersona
@{
    ViewBag.Title = "Editar Persona";
}
<h2>Editar Persona</h2>

<form asp-action="Editar" method="post" class="form-horizontal">
    <input type="hidden" asp-for="PersonaId" />
    <h4>Persona</h4>
    <p class="text-muted"><span class="text-danger">*</span> Campo obligatorio</p>
    <hr />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_Campos" model="Model" />
</form>