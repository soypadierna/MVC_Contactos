@model MVC_Contactos.Models.Cliente
@{
    ViewBag.Title = "Editar Cliente";
    Layout = "~/Views/Shared/_LayoutFacturacion.cshtml";
}
<h2>Editar Cliente</h2>

<form asp-action="Edit" method="post" class="form-horizontal">
    <input type="hidden" asp-for="IdCliente" />
    <h4>Cliente</h4>
    <p class="text-muted"><span class="text-danger">*</span> Campo obligatorio</p>
    <hr />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_Campos" model="Model" />
</form>