@model MVC_Contactos.Models.TBLCATEGORIAS

<div class="form-group">
    <label asp-for="StrDescripcion" class="control-label col-md-2"></label>
    <div class="col-md-10">
        <input asp-for="StrDescripcion" class="form-control" placeholder="Ej: Bebidas" />
        <span asp-validation-for="StrDescripcion" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <div class="col-md-offset-2 col-md-10">
        <input type="submit" value="Guardar" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-default">Cancelar</a>
    </div>
</div>